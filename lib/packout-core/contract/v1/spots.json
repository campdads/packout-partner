{
	"$comment": "POST /partners/spots. A Spot of the partner site, as far as its review there allows. `state` says which shape an item has, and each shape lists every field: an `awaiting` Spot can carry no title, description, landmark, photograph, or credit, because no such field exists for it. Its location is rounded to two decimal places before it is sent, and the hub refuses one that is not. No person is named in any field but `credit`, which is the line the reporter chose to be shown.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"items",
		"contract",
		"core_version",
		"plugin_version"
	],
	"properties": {
		"contract": {
			"type": "integer",
			"minimum": 0,
			"maximum": 1000
		},
		"core_version": {
			"type": "string",
			"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$",
			"maxLength": 40
		},
		"plugin_version": {
			"type": "string",
			"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$",
			"maxLength": 40
		},
		"items": {
			"type": "array",
			"maxItems": 50,
			"items": {
				"$ref": "#/definitions/item"
			}
		}
	},
	"definitions": {
		"item": {
			"type": "object",
			"select": "state",
			"variants": {
				"awaiting": {
					"$ref": "#/definitions/awaiting"
				},
				"published": {
					"$ref": "#/definitions/published"
				},
				"removed": {
					"$ref": "#/definitions/removed"
				}
			}
		},
		"awaiting": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"remote_id",
				"rev",
				"state",
				"category",
				"reported",
				"hazard"
			],
			"properties": {
				"remote_id": {
					"type": "string",
					"pattern": "^[0-9]{1,18}$"
				},
				"rev": {
					"type": "integer",
					"minimum": 1,
					"maximum": 9000000000000000
				},
				"state": {
					"type": "string",
					"enum": [
						"awaiting"
					]
				},
				"category": {
					"$ref": "#/definitions/category"
				},
				"reported": {
					"type": "string",
					"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
				},
				"hazard": {
					"type": "string",
					"pattern": "^[a-z0-9_-]{1,40}$"
				},
				"location": {
					"$ref": "#/definitions/rounded"
				}
			}
		},
		"rounded": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"lat",
				"lng"
			],
			"properties": {
				"lat": {
					"type": "number",
					"minimum": -90,
					"maximum": 90
				},
				"lng": {
					"type": "number",
					"minimum": -180,
					"maximum": 180
				}
			}
		},
		"published": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"remote_id",
				"rev",
				"state",
				"title",
				"url",
				"category",
				"status",
				"hazard",
				"needs_authorization",
				"authorized",
				"description",
				"location",
				"reported",
				"updated",
				"photos"
			],
			"properties": {
				"remote_id": {
					"type": "string",
					"pattern": "^[0-9]{1,18}$"
				},
				"rev": {
					"type": "integer",
					"minimum": 1,
					"maximum": 9000000000000000
				},
				"state": {
					"type": "string",
					"enum": [
						"published"
					]
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200
				},
				"url": {
					"type": "string",
					"pattern": "^https?://",
					"maxLength": 500
				},
				"category": {
					"$ref": "#/definitions/category"
				},
				"status": {
					"type": "string",
					"pattern": "^[a-z0-9_-]{1,40}$"
				},
				"hazard": {
					"type": "string",
					"pattern": "^[a-z0-9_-]{1,40}$"
				},
				"needs_authorization": {
					"type": "boolean"
				},
				"authorized": {
					"type": "boolean"
				},
				"guidance": {
					"type": "string",
					"maxLength": 600
				},
				"description": {
					"type": "string",
					"maxLength": 600
				},
				"location": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"kind",
						"lat",
						"lng",
						"precision"
					],
					"properties": {
						"kind": {
							"type": "string",
							"pattern": "^[a-z_]{1,20}$"
						},
						"lat": {
							"type": [
								"number",
								"null"
							],
							"minimum": -90,
							"maximum": 90
						},
						"lng": {
							"type": [
								"number",
								"null"
							],
							"minimum": -180,
							"maximum": 180
						},
						"precision": {
							"type": "string",
							"enum": [
								"exact",
								"coarse"
							]
						},
						"landmark": {
							"type": "string",
							"maxLength": 200
						}
					}
				},
				"reported": {
					"type": "string",
					"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
				},
				"updated": {
					"type": "string",
					"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
				},
				"credit": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"label"
					],
					"properties": {
						"label": {
							"type": "string",
							"maxLength": 120
						},
						"url": {
							"type": "string",
							"maxLength": 500
						}
					}
				},
				"organization": {
					"type": "string",
					"pattern": "^([0-9]{1,18})?$"
				},
				"photos": {
					"type": "array",
					"maxItems": 36,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"id",
							"of"
						],
						"properties": {
							"id": {
								"type": "string",
								"pattern": "^[0-9]{1,18}$"
							},
							"of": {
								"type": "string",
								"enum": [
									"report",
									"cleanup",
									"visit"
								]
							}
						}
					}
				}
			}
		},
		"removed": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"remote_id",
				"rev",
				"state"
			],
			"properties": {
				"remote_id": {
					"type": "string",
					"pattern": "^[0-9]{1,18}$"
				},
				"rev": {
					"type": "integer",
					"minimum": 1,
					"maximum": 9000000000000000
				},
				"state": {
					"type": "string",
					"enum": [
						"removed"
					]
				}
			}
		},
		"category": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"slug",
				"name"
			],
			"properties": {
				"slug": {
					"type": "string",
					"pattern": "^[a-z0-9-]{0,60}$"
				},
				"name": {
					"type": "string",
					"maxLength": 80
				}
			}
		}
	}
}
